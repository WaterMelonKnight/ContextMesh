{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextmesh.io/schemas/generic-conversation-v1.schema.json",
  "title": "ContextMesh Generic Conversation JSON v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "oneOf": [
    { "required": ["conversation"] },
    { "required": ["conversations"] }
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "conversation": { "$ref": "#/$defs/conversation" },
    "conversations": { "type": "array", "items": { "$ref": "#/$defs/conversation" } }
  },
  "$defs": {
    "nonBlank": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
    "metadata": {
      "type": "object", "maxProperties": 50,
      "description": "Runtime additionally limits total nested entries to 50, depth to 4, and string characters to 16384."
    },
    "conversation": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceType", "messages"],
      "properties": {
        "externalId": { "$ref": "#/$defs/nonBlank" }, "title": { "$ref": "#/$defs/nonBlank" },
        "sourceType": { "enum": ["IMPORTED_CONVERSATION", "NATIVE_CONVERSATION"] },
        "sourceProvider": { "$ref": "#/$defs/nonBlank" },
        "createdAt": { "type": "string", "format": "date-time" }, "updatedAt": { "type": "string", "format": "date-time" },
        "messages": { "type": "array", "items": { "$ref": "#/$defs/message" } },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "message": {
      "type": "object", "additionalProperties": false, "required": ["role", "content"],
      "properties": {
        "externalId": { "$ref": "#/$defs/nonBlank" },
        "role": { "enum": ["SYSTEM", "USER", "ASSISTANT", "TOOL"] },
        "createdAt": { "type": "string", "format": "date-time" }, "parentExternalId": { "$ref": "#/$defs/nonBlank" },
        "content": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/textPart" } },
        "generation": { "$ref": "#/$defs/generation" },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "textPart": {
      "type": "object", "additionalProperties": false, "required": ["type", "text"],
      "properties": { "type": { "const": "TEXT" }, "text": { "type": "string", "minLength": 1 } }
    },
    "generation": {
      "type": "object", "additionalProperties": false, "required": ["provider", "model"],
      "properties": { "provider": { "$ref": "#/$defs/nonBlank" }, "model": { "$ref": "#/$defs/nonBlank" } }
    }
  }
}
